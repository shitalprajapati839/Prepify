<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Prepify</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Prepify.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
            <div class="container">
                @if (User.Identity.IsAuthenticated)
                {
                    <span>Welcome @User.Identity.Name</span>
                }
                <a class="navbar-brand prepify-logo" href="/">
                    Prepify<span class="accent">.</span>
                </a>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav ms-auto">

                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- Logged in -->

                            <li class="nav-item">
                                <span class="nav-link text-white">
                                    👋 @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/User/Quiz/Start">Quiz</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/User/Dashboard">Dashboard</a>
                            </li>

                            <!-- ADMIN ONLY -->
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/Admin/Category/Index">Categories</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/Admin/Question/Index">Questions</a>
                                </li>
                            }

                            <li class="nav-item ms-2">
                                <a class="btn btn-danger" href="/Account/Logout">
                                    Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <!-- Not logged in -->

                            <li class="nav-item">
                                <a class="nav-link" href="/Account/Login">Login</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Account/Register">Register</a>
                            </li>
                        }

                    </ul>
                    
                      
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Prepify - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
