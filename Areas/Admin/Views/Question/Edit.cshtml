<div class="row justify-content-center">
    <div class="col-md-8">

        <div class="card shadow-lg border-0 rounded-4">

            <!-- Header -->
            <div class="card-header bg-warning text-dark text-center rounded-top-4">
                <h4 class="mb-0">✏️ Edit Question</h4>
            </div>

            <!-- Body -->
            <div class="card-body p-4">

                <form action="/Admin/Question/Edit" method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="QuestionId" value="@Model.QuestionId" />

                    <!-- Question -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Question</label>
                        <input type="text" name="Title" value="@Model.Title"
                               class="form-control form-control-lg" />
                    </div>

                    <!-- Options -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Option A</label>
                            <input type="text" name="OptionA" value="@Model.OptionA" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Option B</label>
                            <input type="text" name="OptionB" value="@Model.OptionB" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Option C</label>
                            <input type="text" name="OptionC" value="@Model.OptionC" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Option D</label>
                            <input type="text" name="OptionD" value="@Model.OptionD" class="form-control" />
                        </div>
                    </div>

                    <!-- Correct Answer -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Correct Answer</label>

                        <select name="Answer" class="form-select">

                            <option value="A" @(Model.Answer == "A" ? "selected" : "")>A</option>
                            <option value="B" @(Model.Answer == "B" ? "selected" : "")>B</option>
                            <option value="C" @(Model.Answer == "C" ? "selected" : "")>C</option>
                            <option value="D" @(Model.Answer == "D" ? "selected" : "")>D</option>

                        </select>
                    </div>

                    <!-- Category -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Category</label>

                        <select name="CategoryId" class="form-select">

                            @foreach (var cat in ViewBag.Categories)
                            {
                                <option value="@cat.CategoryId"
                                        @(cat.CategoryId == Model.CategoryId ? "selected" : "")>
                                    @cat.CategoryName
                                </option>
                            }

                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-between">

                        <a href="/Admin/Question/Index" class="btn btn-outline-secondary">
                            ← Back
                        </a>

                        <button type="submit" class="btn btn-primary px-4">
                            💾 Update
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>