<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="card shadow-lg border-0 rounded-4 text-center">

            <!-- Header -->
            <div class="card-header bg-danger text-white rounded-top-4">
                <h4 class="mb-0">🗑️ Delete Category</h4>
            </div>

            <!-- Body -->
            <div class="card-body p-4">

                <p class="fs-5 mb-3">
                    Are you sure you want to delete this category?
                </p>

                <!-- Highlight Category -->
                <div class="alert alert-danger fw-bold">
                    @Model.CategoryName
                </div>

                <!-- Form -->
                <form action="/Admin/Category/Delete" method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.CategoryId" />

                    <div class="d-flex justify-content-center gap-3 mt-4">

                        <button type="submit" class="btn btn-danger px-4">
                            ❌ Delete
                        </button>

                        <a href="/Admin/Category/Index" class="btn btn-outline-secondary px-4">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>