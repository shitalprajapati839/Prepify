@{
    ViewData["Title"] = "User Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- Welcome -->
    <div class="text-center mb-5">
        <h2 class="fw-bold">Welcome, @User.Identity.Name 👋</h2>
        <p class="text-muted">Ready to test your knowledge?</p>
    </div>

    <!-- Cards -->
    <div class="row text-center">

        <!-- Start Quiz -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 p-4 h-100">

                <h4>📝 Start Quiz</h4>
                <p class="text-muted">Attempt MCQ quizzes</p>

                <a href="/User/Quiz/Start" class="btn btn-primary mt-3">
                    Start Now
                </a>

            </div>
        </div>

        <!-- Dashboard -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 p-4 h-100">

                <h4>📊 My Results</h4>
                <p class="text-muted">View your quiz history</p>

                <a href="/User/Dashboard" class="btn btn-success mt-3">
                    View Results
                </a>

            </div>
        </div>

        <!-- Profile / Logout -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 p-4 h-100">

                <h4>⚙️ Account</h4>
                <p class="text-muted">Manage your session</p>

                <a href="/Account/Logout" class="btn btn-danger mt-3">
                    Logout
                </a>

            </div>
        </div>

    </div>

</div>